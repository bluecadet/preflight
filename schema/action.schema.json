{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preflight.dev/schema/action.schema.json",
  "title": "Action",
  "description": "Schema for preflight action.yml files",
  "type": "object",
  "required": [
    "name",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Action name, optionally namespaced, e.g. org/action-name",
      "pattern": "^[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._/-]+)?$"
    },
    "version": {
      "type": "string",
      "description": "Semantic version, e.g. 1.2.0",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "description": "Map of named input definitions",
      "additionalProperties": {
        "$ref": "#/$defs/inputDef"
      }
    },
    "tasks": {
      "type": "array",
      "description": "Ordered list of tasks",
      "items": {
        "$ref": "https://preflight.dev/schema/modules.schema.json#/$defs/task"
      }
    }
  },
  "$defs": {
    "inputDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "bool",
            "int",
            "path",
            "list"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "description": {
          "type": "string"
        }
      }
    }
  }
}
